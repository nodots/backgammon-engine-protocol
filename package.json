{
  "name": "@nodots/backgammon-engine-protocol",
  "version": "0.2.0",
  "description": "Language-neutral wire contract for Nodots backgammon engine plugins (AnalysisProvider). Apache-2.0, zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SPEC.md",
    "bin",
    "conformance",
    "dist",
    "docs/vendor-guide.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p test/tsconfig.json",
    "test": "npm run build && node --test test/runtime.test.js test/conformance.test.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "conformance": "node bin/conformance.mjs"
  },
  "keywords": [
    "backgammon",
    "nodots",
    "engine",
    "protocol",
    "wire-contract"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodots/backgammon-engine-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/nodots/backgammon/issues"
  },
  "homepage": "https://github.com/nodots/backgammon-engine-protocol#readme",
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "bin": {
    "engine-conformance": "./bin/conformance.mjs"
  }
}
